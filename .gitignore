# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# heavy media assets — served from Cloudflare R2 in prod, kept local only
# for the dev experience so we don't ship 4+ GB into git.
/public/assets/0_Landing/
/public/assets/01_Image/
/public/assets/03_Index/
/public/assets/*.zip

# Brand fonts are trial cuts — licensed files replace these before launch
# but the woff2s do need to ship, so they stay tracked deliberately.
